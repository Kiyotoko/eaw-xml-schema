<?xml version="1.1" encoding="utf-8"?>
<!--
  Some content of this schema was added with the help of the Beginner's Modding Guide (PC) by RC1162.
You can check out the guide at
https://gamefaqs.gamespot.com/pc/925180-star-wars-empire-at-war/faqs/45886.
-->
<xsd:schema attributeFormDefault="unqualified" elementFormDefault="qualified"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <xsd:include schemaLocation="eaw-types.xsd" />
  <xsd:complexType name="SpaceUnits">
    <xsd:sequence>
      <xsd:element name="SpaceUnit" maxOccurs="unbounded" minOccurs="1">
        <xsd:complexType>
          <xsd:all>
            <xsd:element type="Identifier" name="Variant_Of_Existing_Type" minOccurs="0" />
            <xsd:element type="Identifier" name="Text_ID" minOccurs="0" />
            <xsd:element type="TxtFile" name="Moniker" minOccurs="0" />
            <xsd:element type="IdentifierSet" name="Encyclopedia_Good_Against" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets which opponents this unit is good against (maximum of 3).
                  Only tells the game what to display in your popup information window for "Good
                  against" and "Vulnerable To". </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="IdentifierSet" name="Encyclopedia_Vulnerable_To" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets which opponents this unit is vulnerable to (maximum of 3).
                  Only tells the game what to display in your popup information window for "Good
                  against" and "Vulnerable To". </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="xsd:integer" name="GUI_Row" minOccurs="0" />
            <xsd:element type="AloModel" name="Space_Model_Name" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets the .alo model name for this unit. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="AloModel" name="xxxSpace_Model_Name" minOccurs="0" />
            <xsd:element type="Color" name="No_Colorization_Color" minOccurs="0" />
            <xsd:element type="xsd:float" name="Mass" minOccurs="0" />
            <xsd:element type="xsd:float" name="Scale_Factor" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets the scale factor of a unit from the model size to the
                  actual in-game size. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="xsd:float" name="Dense_FOW_Reveal_Range_Multiplier" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets the reveal range of the fog of war in multiplayer. See
                  Space_FOW_Reveal_Range for singleplayer. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="xsd:integer" name="Damage" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets how much damage the unit does in an autoresolved battle. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="xsd:integer" name="Autoresolve_Health" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets how much health the unit has in an autoresolved battle.
                  Note: Tactical health is defined at Tactical_Health. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="xsd:integer" name="Shield_Points" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets how many shield points the unit has. Set to -1 for
                  infinite. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="xsd:integer" name="Tactical_Health" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets how many shield points the unit has. Set to -1 for
                  infinite. Note: Autoresolve health is defined at Autoresolve_Health. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="xsd:integer" name="Shield_Refresh_Rate" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets the interval in seconds to refresh a part of the shield.
                  For comparisation, capital ships like the calamari cruiser have a value of 50 and
                  corvets a value between 10 and 20. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="xsd:integer" name="Energy_Capacity" minOccurs="0" />
            <xsd:element type="xsd:integer" name="Energy_Refresh_Rate" minOccurs="0" />
            <xsd:element type="xsd:integer" name="Ranking_In_Category" minOccurs="0" />
            <xsd:element type="xsd:float" name="Max_Speed" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets how fast a unit can move. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="xsd:float" name="Max_Rate_Of_Turn" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets how fast a unit can turn. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="Identifier" name="MovementClass" minOccurs="0" />
            <xsd:element type="Identifier" name="Space_Layer" minOccurs="0" />
            <xsd:element type="xsd:float" name="Layer_Z_Adjust" minOccurs="0" />
            <xsd:element type="xsd:float" name="Max_Rate_Of_Roll" minOccurs="0" />
            <xsd:element type="xsd:integer" name="Bank_Turn_Angle" minOccurs="0" />
            <xsd:element type="xsd:float" name="OverrideAcceleration" minOccurs="0" />
            <xsd:element type="xsd:float" name="OverrideDeceleration" minOccurs="0" />
            <xsd:element type="Identifier" name="Armor_Type" minOccurs="0" />
            <xsd:element type="Identifier" name="Shield_Armor_Type" minOccurs="0" />
            <xsd:element type="xsd:float" name="Max_Thrust" minOccurs="0" />
            <xsd:element type="Identifier" name="Hyperspace" minOccurs="0" />
            <xsd:element type="xsd:float" name="Select_Box_Scale" minOccurs="0" />
            <xsd:element type="xsd:float" name="Select_Box_Z_Adjust" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets the z axis adjustment aka. the height level adjustment for
                  the model. This should be normally negative. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="xsd:float" name="Ranged_Target_Z_Adjust" minOccurs="0" />
            <xsd:element type="xsd:float" name="Hyperspace_Speed" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets how fast a unit goes from planet to planet in the Galactic
                  View groups of units only travel as fast as the slowest unit, a higher number mean
                  faster speed. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="xsd:float" name="Maintenance_Cost" minOccurs="0" />
            <xsd:element type="IdentifierList" name="Affiliation" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets the faction affiliation for this unit. It takes a list of
                  faction names separated by a comma. The valid faction names in the base game are:
                  Pirates, Empire, Rebel </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="Identifier" name="Build_Initially_Locked" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets whether or not the unit must be researched/stolen when tech
                  level is reached (Yes/No). </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="Identifier" name="Build_Can_Be_Unlocked_By_Slicer" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets whether or not the unit must be researched/stolen when tech
                  level is reached (Yes/No). </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="xsd:integer" name="Slice_Cost_Credits" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets what the slice cost is if the build is initially locked,
                  and can be unlocked by slicer (Yes/No). </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="xsd:integer" name="Tech_Level" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets the tech level unit becomes available, for Rebels 0-3, for
                  the Empire 1-4. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="xsd:integer" name="Required_Timeline" minOccurs="0" />
            <xsd:element type="xsd:integer" name="Required_Ground_Base_Level" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets what ground base level is required to build the unit. Note:
                  You can set it to 0 to never have to build a ground base to build space units. For
                  space units this is normally 0. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="xsd:integer" name="Required_Star_Base_Level" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets what space station level is required to build the unit.
                  Note: You can set it to 0 to never have to build a space station to build space
                  units. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="Identifier" name="Required_Special_Structures" minOccurs="0" />
            <xsd:element type="Identifier" name="Required_Planets" minOccurs="0" />
            <xsd:element type="Identifier" name="Ship_Class" minOccurs="0" />
            <xsd:element type="YesNo" name="Surface_Bombardment_Capable" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets whether or not a unit allows surface bombarding in groud
                  battles (Yes/No). Defaults to no. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="xsd:integer" name="Formation_Priority" minOccurs="0" />
            <xsd:element type="Identifier" name="Is_Escort" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets whether or not a unit can guard other units (Yes/No). </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="YesNo" name="Is_Bomber" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets whether or not a unit is a bomber (Yes/No). </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="xsd:integer" name="Political_Control" minOccurs="0" />
            <xsd:element type="xsd:integer" name="Squadron_Capacity" minOccurs="0" />
            <xsd:element type="xsd:integer" name="Transport_Capacity" minOccurs="0" />
            <xsd:element type="xsd:integer" name="Number_per_Squadron" minOccurs="0" />
            <xsd:element type="xsd:integer" name="Build_Cost_Credits" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets how many credits you have to spend to build the unit. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="xsd:integer" name="AI_Combat_Power" minOccurs="0" />
            <xsd:element type="xsd:integer" name="Build_Time_Seconds" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets the build time for the unit in seconds. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="YesNo" name="Build_Tab_Space_Units" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets whether or not it's part of the queue for space units
                  (Yes/No). </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="xsd:integer" name="Size_Value" minOccurs="0" />
            <xsd:element type="IdentifierList" name="Behavior" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets the list of behaviors for this unit. The values are
                  separated by a comma. Valid values in the base game are: - SELECTABLE = This unit
                  can be selected. - DUMMY_STARSHIP - POWERED - SHIELDED </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="IdentifierList" name="SpaceBehavior" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets the list of space behaviors for this unit. The values are
                  separated by a comma. Valid values in the base game are: - TACTICAL_SUPER_WEAPON =
                  This unit is a super weapon. - IDLE = This unit does nothing in battle. For
                  example, the death star has idle as a behavior. - FIGHTER_LOCOMOTOR - SELECTABLE =
                  This unit can be selected. - TARGETING - WEAPON = This unit has weapons. -
                  HIDE_WHEN_FOGGED = This unit is hidden when it is inside the fog of war. Large
                  unis like super weapons may not want to have this behavior. - AMBIENT_SFX -
                  DAMAGE_TRACKING - NEBULA = This units abilities are suppressed inside a nebula
                  aka. is effected by a nebula. - ABILITY_COUNTDOWN = This units abilities have a
                  countdown and/or a cooldown. - SIMPLE_SPACE_LOCOMOTOR - REVEAL - UNIT_AI -
                  ASTEROID_FIELD_DAMAGE = This unit can be damaged by asteroids. - SPAWN_SQUADRON =
                  This unit can spawn squadrons. - DAMAGE_TRACKING - ION_STUN_EFFECT Note that space
                  behaviours are a subset of common behaviours, see the Behaviour element. In theory
                  you can load common behaviours inside this element, but just because you can does
                  not mean you should. For example, you can load SHIELDED, which is a common
                  behaviour, inside this list of space behaviours. It is recommended to split
                  behaviours because it makes them more readable and is guaranteed to work where
                  mixing different types of behaviours can lead to bugs and loading failures. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>

            <xsd:element type="xsd:float" name="Space_FOW_Reveal_Range" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets the reveal range of the fog of war. See
                  Dense_FOW_Reveal_Range_Multiplier for multiplayer. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="xsd:float" name="Targeting_Max_Attack_Distance" minOccurs="0" />
            <xsd:element type="YesNo" name="Collidable_By_Projectile_Living" minOccurs="0" />
            <xsd:element type="YesNo" name="Death_Leave_Hulk_Behind" minOccurs="0" />
            <xsd:element type="IdentifierList" name="Death_Clone" minOccurs="0" />
            <xsd:element type="Identifier" name="Asteroid_Damage_Hit_Particles" minOccurs="0" />
            <xsd:element type="YesNo" name="In_Background" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets if this unit is only in the background. For example, this
                  is the case for the death star. Default is no (Yes/No). </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="IdentifierList" name="HardPoints" minOccurs="0" />
            <xsd:element type="IdentifierList" name="Target_Bones" minOccurs="0" />

            <xsd:element type="IdentifierMask" name="CategoryMask" minOccurs="0" />
            <xsd:element type="TgaImage" name="Icon_Name" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets the .tga icon name for this unit. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="AloModel" name="GUI_Model_Name" minOccurs="0" />
            <xsd:element type="xsd:integer" name="GUI_Distance" minOccurs="0" />
            <xsd:element type="Vector3" name="GUI_Offset" minOccurs="0" />
            <xsd:element type="xsd:integer" name="GUI_Velocity" minOccurs="0" />
            <xsd:element type="YesNo" name="Victory_Relevant" minOccurs="0" />
            <xsd:element type="YesNo" name="Has_Space_Evaluator" minOccurs="0" />
            <xsd:element type="YesNo" name="Is_Interdictor" minOccurs="0" />
            <xsd:element type="YesNo" name="Disallows_Hyperspace_Retreat" minOccurs="0" />
            <xsd:element type="xsd:int" name="Reinforcement_Prevention_Radius" minOccurs="0" />
            <xsd:element type="YesNo" name="Play_SFXEvent_On_Sighting" minOccurs="0" />
            <xsd:element type="Identifier" name="SFXEvent_Build_Started" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets the sound effect that is played when this unit build
                  started. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="Identifier" name="SFXEvent_Build_Cancelled" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets the sound effect that is played when this unit build was
                  cancelled. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="Identifier" name="SFXEvent_Build_Complete" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets the sound effect that is played when this unit build is
                  complete. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="Identifier" name="SFXEvent_Ambient_Loop" minOccurs="0" />
            <xsd:element type="Identifier" name="SFXEvent_Select" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets the sound effect that is played when this unit is selected. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="Identifier" name="SFXEvent_Move" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets the sound effect that is played when this unit moves. This
                  is played only once when the move command was set for this unit. It is not the
                  sound for the engine. You can set this sound at SFXEvent_Engine_Idle_Loop and
                  SFXEvent_Engine_Moving_Loop. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="Identifier" name="SFXEvent_Fleet_Move" minOccurs="0" />
            <xsd:element type="Identifier" name="SFXEvent_Attack" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets the sound effect that is played when this unit attacks
                  another unit. This is triggered by the attack command. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="Identifier" name="SFXEvent_Guard" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets the sound effect that is played when this unit guards
                  another unit. This is triggered by the guard command. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="Identifier" name="SFXEvent_Stop" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets the sound effect that is played when this unit stops. This
                  is triggered by the stop command. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="Identifier" name="SFXEvent_Barrage" minOccurs="0" />
            <xsd:element type="Identifier" name="SFXEvent_Move_Into_Asteroid_Field" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets the sound effect that is played when this unit moves into
                  an asteroid field. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="Identifier" name="SFXEvent_Move_Into_Nebula" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets the sound effect that is played when this unit moves into a
                  nebula field. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="Identifier" name="SFXEvent_Damaged_By_Asteroid" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets the sound effect that is played when this unit is damaged
                  by an asteroid field. This is commonly SFX_Asteroid_Detonation. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="IdentifierList" name="SFXEvent_Attack_Hardpoint" maxOccurs="unbounded"
              minOccurs="0" />
            <xsd:element type="IdentifierList" name="SFXEvent_Hardpoint_Destroyed" maxOccurs="unbounded"
              minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets the sound effect that is played when a hardpoint of this
                  unit is destroyed. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="Identifier" name="SFXEvent_Engine_Idle_Loop" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets the sound effect that is played for the engine. The sound
                  effect is looped and always played in idle, aka. if no action is performend. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>

            <xsd:element type="Identifier" name="SFXEvent_Engine_Moving_Loop" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets the sound effect that is played for the engine when this
                  unit moves. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="Identifier" name="SFXEvent_Engine_Cinematic_Focus_Loop" minOccurs="0" />
            <xsd:element type="Identifier" name="Death_SFXEvent_Start_Die" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets the sound effect that is played when this unit gets
                  destroyed. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="Identifier" name="Death_Explosions" minOccurs="0" />
            <xsd:element type="Identifier" name="SFXEvent_Bombard_Select_Target" minOccurs="0" />
            <xsd:element type="Identifier" name="SFXEvent_Bombard_Incoming" minOccurs="0" />
            <xsd:element type="Identifier" name="SFXEvent_Tactical_Build_Cancelled" minOccurs="0" />
            <xsd:element type="Identifier" name="SFXEvent_Health_Critical_Warning" minOccurs="0" />
            <xsd:element type="Identifier" name="SFXEvent_Tactical_Build_Started" minOccurs="0" />
            <xsd:element type="Identifier" name="SFXEvent_Tactical_Build_Complete" minOccurs="0" />
            <xsd:element type="xsd:integer" name="Spawned_Squadron_Delay_Seconds" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Defines the delay between spawning a new squadron in seconds. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="IdentifierIntTuple" name="Starting_Spawned_Units_Tech_0" maxOccurs="unbounded"
              minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Pair of a squadron unit and the number spawned, separated by a
                  comma. Multiple items define multiple squadron types. Defines squadrons for tech 0
                  and later. Can be overwritten to define squadrons for a later tech level. This
                  entry might look like this: TIE_Fighter_Squadron, 2 </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="IdentifierIntTuple" name="Reserve_Spawned_Units_Tech_0" maxOccurs="unbounded" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Pair of a squadron unit and the number in reserve, separated by
                  a comma. Multiple items define multiple squadron types. Defines reserve squadrons
                  for tech 0 and later. Can be overwritten to define squadrons for a later tech
                  level. This entry might look like this: TIE_Fighter_Squadron, 8 </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="IdentifierIntTuple" name="Starting_Spawned_Units_Tech_1" maxOccurs="unbounded"
              minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Pair of a squadron unit and the number spawned, separated by a
                  comma. Multiple items define multiple squadron types. Defines squadrons for tech 1
                  and later. Can be overwritten to define squadrons for a later tech level. This
                  entry might look like this: TIE_Fighter_Squadron, 2 </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="IdentifierIntTuple" name="Reserve_Spawned_Units_Tech_1" maxOccurs="unbounded" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Pair of a squadron unit and the number in reserve, separated by
                  a comma. Multiple items define multiple squadron types. Defines reserve squadrons
                  for tech 1 and later. Can be overwritten to define squadrons for a later tech
                  level. This entry might look like this: TIE_Fighter_Squadron, 8 </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="IdentifierIntTuple" name="Starting_Spawned_Units_Tech_2" maxOccurs="unbounded"
              minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Pair of a squadron unit and the number spawned, separated by a
                  comma. Multiple items define multiple squadron types. Defines squadrons for tech 2
                  and later. Can be overwritten to define squadrons for a later tech level. This
                  entry might look like this: TIE_Fighter_Squadron, 2 </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="IdentifierIntTuple" name="Reserve_Spawned_Units_Tech_2" maxOccurs="unbounded" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Pair of a squadron unit and the number in reserve, separated by
                  a comma. Multiple items define multiple squadron types. Defines reserve squadrons
                  for tech 2 and later. Can be overwritten to define squadrons for a later tech
                  level. This entry might look like this: TIE_Fighter_Squadron, 8 </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="IdentifierIntTuple" name="Starting_Spawned_Units_Tech_3" maxOccurs="unbounded"
              minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Pair of a squadron unit and the number spawned, separated by a
                  comma. Multiple items define multiple squadron types. Defines squadrons for tech 3
                  and later. Can be overwritten to define squadrons for a later tech level. This
                  entry might look like this: TIE_Fighter_Squadron, 2 </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="IdentifierIntTuple" name="Reserve_Spawned_Units_Tech_3" maxOccurs="unbounded" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Pair of a squadron unit and the number in reserve, separated by
                  a comma. Multiple items define multiple squadron types. Defines reserve squadrons
                  for tech 3 and later. Can be overwritten to define squadrons for a later tech
                  level. This entry might look like this: TIE_Fighter_Squadron, 8 </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="IdentifierIntTuple" name="Starting_Spawned_Units_Tech_4" maxOccurs="unbounded"
              minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Pair of a squadron unit and the number spawned, separated by a
                  comma. Multiple items define multiple squadron types. Defines squadrons for tech 4
                  and later. Can be overwritten to define squadrons for a later tech level. This
                  entry might look like this: TIE_Fighter_Squadron, 2 </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="IdentifierIntTuple" name="Reserve_Spawned_Units_Tech_4" maxOccurs="unbounded" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Pair of a squadron unit and the number in reserve, separated by
                  a comma. Multiple items define multiple squadron types. Defines reserve squadrons
                  for tech 4 and later. Can be overwritten to define squadrons for a later tech
                  level. This entry might look like this: TIE_Fighter_Squadron, 8 </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="IdentifierIntTuple" name="Starting_Spawned_Units_Tech_5" maxOccurs="unbounded"
              minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Pair of a squadron unit and the number spawned, separated by a
                  comma. Multiple items define multiple squadron types. Defines squadrons for tech
                  5. This entry might look like this: TIE_Fighter_Squadron, 2 </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="IdentifierIntTuple" name="Reserve_Spawned_Units_Tech_5" maxOccurs="unbounded" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Pair of a squadron unit and the number in reserve, separated by
                  a comma. Multiple items define multiple squadron types. Defines reserve squadrons
                  for tech 5. This entry might look like this: TIE_Fighter_Squadron, 8 </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="Identifier" name="Space_Full_Stop_Command" minOccurs="0" />
            <xsd:element type="Identifier" name="Is_Visible_On_Radar" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets whether or not the unit is visible on radar (Yes/No). </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="Identifier" name="Radar_Icon_Name" minOccurs="0" />
            <xsd:element type="Identifier" name="Radar_Icon_Size" minOccurs="0" />
            <xsd:element type="xsd:float" name="Radar_Icon_Scale_Land" minOccurs="0" />
            <xsd:element type="xsd:float" name="Radar_Icon_Scale_Space" minOccurs="0" />
            <xsd:element type="xsd:float" name="Guard_Chase_Range" minOccurs="0" />
            <xsd:element type="xsd:float" name="Idle_Chase_Range" minOccurs="0" />
            <xsd:element type="xsd:float" name="Attack_Move_Response_Range" minOccurs="0" />
            <xsd:element type="xsd:float" name="Targeting_Stickiness_Time_Threshold" minOccurs="0" />
            <xsd:element type="Identifier" name="Targeting_Priority_Set" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets which type of enemies should be prioritized by this unit.
                  For example, you can set this value to "Frigate" for always prioritizing frigates.
                  Valid values in the base game are: Corvette, Frigate, Capital, Fighter, Bomber </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="Identifier" name="Lua_Script" minOccurs="0" />
            <xsd:element name="Unit_Abilities_Data" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> List of activated abilities. Activated abilities are abilities
                  that can be activated and deactivated. </xsd:documentation>
              </xsd:annotation>
              <xsd:complexType>
                <xsd:sequence>
                  <xsd:element name="Unit_Ability" maxOccurs="unbounded">
                    <xsd:annotation>
                      <xsd:documentation>Primary ability</xsd:documentation>
                    </xsd:annotation>
                    <xsd:complexType>
                      <xsd:all maxOccurs="1" minOccurs="0">
                        <xsd:element type="Identifier" name="Type" minOccurs="0" />
                        <xsd:element type="YesNo" name="Disable_Movement" minOccurs="0" />
                        <xsd:element type="xsd:int" name="Effective_Radius" minOccurs="0" />
                        <xsd:element type="xsd:float" name="Recharge_Seconds" minOccurs="0" />
                        <xsd:element type="IdentifierFloatTuple" name="Mod_Multiplier" maxOccurs="unbounded" minOccurs="0" />
                        <xsd:element type="xsd:integer" name="Expiration_Seconds" minOccurs="0" />
                        <xsd:element type="Identifier" name="Alternate_Name_Text" minOccurs="0" />
                        <xsd:element type="Identifier" name="Alternate_Description_Text"
                          minOccurs="0" />
                        <xsd:element type="Identifier" name="Alternate_Icon_Name" minOccurs="0" />
                        <xsd:element type="Identifier" name="SFXEvent_GUI_Unit_Ability_Activated"
                          minOccurs="0" />
                        <xsd:element type="Identifier" name="SFXEvent_GUI_Unit_Ability_Deactivated"
                          minOccurs="0" />
                      </xsd:all>
                    </xsd:complexType>
                  </xsd:element>
                </xsd:sequence>
                <xsd:attribute type="Identifier" name="SubObjectList" />
              </xsd:complexType>
            </xsd:element>
            <xsd:element name="Abilities" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> List of passiv abilities. Passiv abilities are abilities that
                  are always activated or activate automatically. </xsd:documentation>
              </xsd:annotation>
              <xsd:complexType>
                <xsd:sequence />
              </xsd:complexType>
            </xsd:element>
            <xsd:element type="Identifier" name="Encyclopedia_Text" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets the encyclopedia text. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="Identifier" name="Encyclopedia_Unit_Class" minOccurs="0" />
            <xsd:element type="xsd:integer" name="Score_Cost_Credits" minOccurs="0" />

            <xsd:element type="xsd:integer" name="Tactical_Build_Cost_Multiplayer" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Build cost in credits for tactical multiplayer. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="xsd:integer" name="Tactical_Build_Time_Seconds" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Build time in seconds for tactical multiplayer. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="Identifier" name="Tactical_Build_Prerequisites" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Build prerequsites for tactical multiplayer. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="Identifier" name="Tactical_Production_Queue" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Production queue for tactical multiplayer. For space units this
                  is normally Tactical_Units. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="xsd:integer" name="Population_Value" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets how much of a population the unit takes up (fighters are
                  normally 1). Can be set it to 0 for an unlimited number of the unit in a battle. </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element type="xsd:integer" name="Custom_Hard_XExtent" minOccurs="0" />
            <xsd:element type="xsd:float" name="Death_Persistence_Duration" minOccurs="0" />
            <xsd:element type="Identifier" name="Remove_Upon_Death" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation> Sets if this unit should be directly removed upon death
                  (true/false). </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
          </xsd:all>
          <xsd:attribute type="Identifier" name="Name"></xsd:attribute>
        </xsd:complexType>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:element name="SpaceUnitsFrigates" type="SpaceUnits" />
</xsd:schema>
