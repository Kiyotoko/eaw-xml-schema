<?xml version='1.0' encoding='UTF-8'?>
<!--
  Some content of this schema was added with the help of the Beginner's Modding Guide (PC) by RC1162.
You can check out the guide at
https://gamefaqs.gamespot.com/pc/925180-star-wars-empire-at-war/faqs/45886.
-->
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" attributeFormDefault="unqualified"
  elementFormDefault="qualified">
  <xsd:include schemaLocation="https://kiyotoko.github.io/eaw-xml-schema/schemas/eaw-types.xsd" />
  <xsd:complexType name="Ability">
    <xsd:sequence>
      <xsd:choice maxOccurs="unbounded">
        <xsd:element type="xsd:float" name="Activation_Max_Range" />
        <xsd:element type="xsd:float" name="Activation_Min_Range" />
        <xsd:element type="Identifier" name="Activation_Style" />
        <xsd:element type="Identifier" name="Alternate_Description_Text" />
        <xsd:element type="Identifier" name="Alternate_Icon_Name" />
        <xsd:element type="Identifier" name="Alternate_Name_Text" />
        <xsd:element type="IdentifierMask" name="Applicable_Unit_Categories" />
        <xsd:element type="IdentifierList" name="Applicable_Unit_Types" />
        <xsd:element type="xsd:float" name="Area_Effect_Decal_Distance" />
        <xsd:element type="YesNo" name="Disable_Movement" />
        <xsd:element type="xsd:float" name="Effective_Radius" />
        <xsd:element type="xsd:integer" name="Expiration_Seconds" />
        <xsd:element type="Identifier" name="GUI_Activated_Ability_Name" />
        <xsd:element type="YesNo" name="Is_Pulsing" />
        <xsd:element type="xsd:int" name="Max_Number_Of_Pulses" />
        <xsd:element type="IdentifierFloatTuple" name="Mod_Multiplier" />
        <xsd:element type="Identifier" name="Particle_Effect" />
        <xsd:element type="Identifier" name="Projectile_Types_Override" />
        <xsd:element type="xsd:float" name="Pulse_Frequency_Secs" />
        <xsd:element type="xsd:float" name="Recharge_Seconds" />
        <xsd:element type="Identifier" name="SFXEvent_GUI_Unit_Ability_Activated" />
        <xsd:element type="Identifier" name="SFXEvent_GUI_Unit_Ability_Deactivated" />
        <xsd:element type="Identifier" name="SFXEvent_Special_Ability_Loop" />
        <xsd:element type="Identifier" name="SFXEvent_Target_Ability" />
        <xsd:element type="YesNo" name="Should_Attacker_Hold_Fire_For_Special_Ability" />
        <xsd:element type="Identifier" name="Spawned_Object_Type">
          <xsd:annotation>
            <xsd:documentation> Example: Proj_Special_Space_FOW_Reveal_Ping_Blast </xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:element type="xsd:int" name="Stacking_Category" />
        <xsd:element type="xsd:int" name="Target_Position_Z_Offset" />
        <xsd:element type="xsd:float" name="Target_Speed_Decrease_Percent" />
        <xsd:element type="IdentifierList" name="Target_Types">
          <xsd:annotation>
            <xsd:documentation> List of space units that can be targeted by this ability. Example:
              TIE_Fighter, TIE_Fighter_Squadron </xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:element type="xsd:float" name="Targeting_Fire_Inaccuracy_Fixed_Radius_Override" />
        <xsd:element type="Identifier" name="Type" />
      </xsd:choice>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="SpaceUnits">
    <xsd:sequence>
      <xsd:element name="SpaceUnit" maxOccurs="unbounded" minOccurs="1">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:choice maxOccurs="unbounded">
              <xsd:element name="Abilities">
                <xsd:annotation>
                  <xsd:documentation> List of passiv abilities. Passiv abilities are abilities that
                    are always activated or activate automatically. </xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="Tractor_Beam_Attack_Ability">
                      <xsd:complexType>
                        <xsd:complexContent>
                          <xsd:extension base="Ability">
                            <xsd:attribute type="Identifier" name="Name" />
                          </xsd:extension>
                        </xsd:complexContent>
                      </xsd:complexType>
                    </xsd:element>
                  </xsd:sequence>
                  <xsd:attribute type="YesNo" name="SubObjectList" />
                </xsd:complexType>
              </xsd:element>
              <xsd:element type="IdentifierList" name="Affiliation">
                <xsd:annotation>
                  <xsd:documentation> Sets the faction affiliation for this unit. It takes a list of
                    faction names separated by a comma. The valid faction names in the base game
                    are: Pirates, Empire, Rebel </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="xsd:integer" name="AI_Combat_Power" />
              <xsd:element type="YesNo" name="Air_Vehicle_Turret_Target" />
              <xsd:element type="Identifier" name="Armor_Type" />
              <xsd:element type="Identifier" name="Asteroid_Damage_Hit_Particles" />
              <xsd:element type="xsd:float" name="Attack_Move_Response_Range" />
              <xsd:element type="xsd:float" name="Autonomous_Move_Extension_Vs_Attacker" />
              <xsd:element type="xsd:integer" name="Autoresolve_Health">
                <xsd:annotation>
                  <xsd:documentation> Sets how much health the unit has in an autoresolved battle.
                    Note: Tactical health is defined at Tactical_Health. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="xsd:float" name="Avoid_Enemy_Exclusion_Range" />
              <xsd:element type="xsd:integer" name="Bank_Turn_Angle" />
              <xsd:element type="xsd:float" name="Begin_Turn_Towards_Distance" />
              <xsd:element type="IdentifierList" name="Behavior">
                <xsd:annotation>
                  <xsd:documentation> Sets the list of behaviors for this unit. The values are
                    separated by a comma. Valid values in the base game are: - SELECTABLE = This
                    unit can be selected. - DUMMY_STARSHIP - POWERED - SHIELDED </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="Identifier" name="Build_Can_Be_Unlocked_By_Slicer">
                <xsd:annotation>
                  <xsd:documentation> Sets whether or not the unit must be researched/stolen when
                    tech level is reached (Yes/No). </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="xsd:integer" name="Build_Cost_Credits">
                <xsd:annotation>
                  <xsd:documentation> Sets how many credits you have to spend to build the unit. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="Identifier" name="Build_Initially_Locked">
                <xsd:annotation>
                  <xsd:documentation> Sets whether or not the unit must be researched/stolen when
                    tech level is reached (Yes/No). </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="YesNo" name="Build_Tab_Space_Units">
                <xsd:annotation>
                  <xsd:documentation> Sets whether or not it's part of the queue for space units
                    (Yes/No). </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="xsd:integer" name="Build_Time_Seconds">
                <xsd:annotation>
                  <xsd:documentation> Sets the build time for the unit in seconds. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="IdentifierMask" name="CategoryMask" />
              <xsd:element type="YesNo" name="Collidable_By_Projectile_Living" />
              <xsd:element type="xsd:float" name="Collision_Box_Modifier" />
              <xsd:element type="YesNo" name="Create_Team" />
              <xsd:element type="xsd:float" name="Custom_Footprint_Radius" />
              <xsd:element type="xsd:integer" name="Custom_Hard_XExtent" />
              <xsd:element type="xsd:integer" name="Damage">
                <xsd:annotation>
                  <xsd:documentation> Sets how much damage the unit does in an autoresolved battle. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="Identifier" name="Damage_Type">
                <xsd:annotation>
                  <xsd:documentation> Example: Damage_AWing </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="IdentifierList" name="Death_Clone" />
              <xsd:element type="Identifier" name="Death_Explosions" />
              <xsd:element type="YesNo" name="Death_Leave_Hulk_Behind" />
              <xsd:element type="xsd:float" name="Death_Persistence_Duration" />
              <xsd:element type="Identifier" name="Death_SFXEvent_Start_Die">
                <xsd:annotation>
                  <xsd:documentation> Sets the sound effect that is played when this unit gets
                    destroyed. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="xsd:float" name="Dense_FOW_Reveal_Range_Multiplier">
                <xsd:annotation>
                  <xsd:documentation> Sets the reveal range of the fog of war in multiplayer. See
                    Space_FOW_Reveal_Range for singleplayer. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="YesNo" name="Disallows_Hyperspace_Retreat" />
              <xsd:element type="IdentifierSet" name="Encyclopedia_Good_Against">
                <xsd:annotation>
                  <xsd:documentation> Sets which opponents this unit is good against (maximum of 3).
                    Only tells the game what to display in your popup information window for "Good
                    against" and "Vulnerable To". </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="IdentifierSet" name="Encyclopedia_Text">
                <xsd:annotation>
                  <xsd:documentation> Sets the encyclopedia text. This is a set of all translations
                    used. For example, the value TEXT_TOOLTIP_MON_CALAMARI_CRUISER
                    TEXT_TOOLTIP_REQUIRED_PLANETS_CAPITAL_SHIPS will fist display the tooltip for
                    the mon calamari cruiser and then the tooltip for required planets. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="Identifier" name="Encyclopedia_Unit_Class" />
              <xsd:element type="IdentifierSet" name="Encyclopedia_Vulnerable_To">
                <xsd:annotation>
                  <xsd:documentation> Sets which opponents this unit is vulnerable to (maximum of
                    3). Only tells the game what to display in your popup information window for
                    "Good against" and "Vulnerable To". </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="xsd:integer" name="Energy_Capacity" />
              <xsd:element type="xsd:integer" name="Energy_Refresh_Rate" />
              <xsd:element type="IdentifierFloatTuple" name="Fire_Inaccuracy_Distance">
                <xsd:annotation>
                  <xsd:documentation> Example: Fighter, 1.0 </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="YesNo" name="Fires_Forward">
                <xsd:annotation>
                  <xsd:documentation> If set to yes, this space unit can only fire forward.
                    Otherwise the fire angle depends on its turrets. This option is commonly used
                    for fighters. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="xsd:integer" name="Formation_Priority" />
              <xsd:element type="xsd:int" name="FormationOrder" />
              <xsd:element type="xsd:integer" name="FormationPriority" />
              <xsd:element type="TecAnimation" name="Glory_Cinematics">
                <xsd:annotation>
                  <xsd:documentation> Animation that are played, mostly used for death clones.
                    Example: CAM_Calamari_Cruiser_Die.tec </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="xsd:float" name="Guard_Chase_Range" />
              <xsd:element type="xsd:int" name="GUI_Bracket_Height" />
              <xsd:element type="xsd:int" name="GUI_Bracket_Size" />
              <xsd:element type="xsd:integer" name="GUI_Distance" />
              <xsd:element type="AloModel" name="GUI_Model_Name" />
              <xsd:element type="Vector3" name="GUI_Offset" />
              <xsd:element type="xsd:integer" name="GUI_Row" />
              <xsd:element type="xsd:integer" name="GUI_Velocity" />
              <xsd:element type="IdentifierList" name="HardPoints" />
              <xsd:element type="YesNo" name="Has_Space_Evaluator" />
              <xsd:element type="Identifier" name="Hyperspace" />
              <xsd:element type="xsd:float" name="Hyperspace_Speed">
                <xsd:annotation>
                  <xsd:documentation> Sets how fast a unit goes from planet to planet in the
                    Galactic View groups of units only travel as fast as the slowest unit, a higher
                    number mean faster speed. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="TgaImage" name="Icon_Name">
                <xsd:annotation>
                  <xsd:documentation> Sets the .tga icon name for this unit. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="xsd:float" name="Idle_Chase_Range" />
              <xsd:element type="YesNo" name="In_Background">
                <xsd:annotation>
                  <xsd:documentation> Sets if this unit is only in the background. For example, this
                    is the case for the death star. Default is no (Yes/No). </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="YesNo" name="Is_Bomber">
                <xsd:annotation>
                  <xsd:documentation> Sets whether or not a unit is a bomber (Yes/No). </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="Identifier" name="Is_Escort">
                <xsd:annotation>
                  <xsd:documentation> Sets whether or not a unit can guard other units (Yes/No). </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="YesNo" name="Is_Interdictor" />
              <xsd:element type="Identifier" name="Is_Visible_On_Radar">
                <xsd:annotation>
                  <xsd:documentation> Sets whether or not the unit is visible on radar (Yes/No). </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="Identifier" name="Land_Bomber_Type">
                <xsd:annotation>
                  <xsd:documentation> Example: TIE_Bomber_Bombing_Run </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="xsd:float" name="Land_FOW_Reveal_Range">
                <xsd:annotation>
                  <xsd:documentation> Example: 130.0 </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="xsd:float" name="Layer_Z_Adjust" />
              <xsd:element type="Identifier" name="Lua_Script" />
              <xsd:element type="xsd:float" name="Maintenance_Cost" />
              <xsd:element type="xsd:float" name="Mass" />
              <xsd:element type="xsd:float" name="Max_Lift" />
              <xsd:element type="xsd:float" name="Max_Rate_Of_Roll" />
              <xsd:element type="xsd:float" name="Max_Rate_Of_Turn">
                <xsd:annotation>
                  <xsd:documentation> Sets how fast a unit can turn. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="xsd:float" name="Max_Speed">
                <xsd:annotation>
                  <xsd:documentation> Sets how fast a unit can move. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="xsd:float" name="Max_Thrust" />
              <xsd:element type="xsd:float" name="Min_Speed">
                <xsd:annotation>
                  <xsd:documentation> Sets how fast a unit must move, used for fighters. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="xsd:float" name="Min_Speed_Fraction_For_Turn" />
              <xsd:element type="xsd:float" name="Minimum_Follow_Distance" />
              <xsd:element type="TxtFile" name="Moniker" />
              <xsd:element type="xsd:float" name="Mouse_Collide_Override_Sphere_Radius" />
              <xsd:element type="Identifier" name="MovementClass" />
              <xsd:element type="YesNo" name="Multisample_FOW_Check">
                <xsd:annotation>
                  <xsd:documentation> Sets if multiple checks are performed for fog of war. This
                    value is generelly set to yes for for large ships like capitals. Default is no
                    (Yes/No). </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="Color" name="No_Colorization_Color" />
              <xsd:element type="xsd:integer" name="Number_per_Squadron" />
              <xsd:element type="xsd:float" name="Out_Of_Combat_Defense_Adjustment" />
              <xsd:element type="xsd:float" name="OverrideAcceleration" />
              <xsd:element type="xsd:float" name="OverrideDeceleration" />
              <xsd:element type="YesNo" name="Play_SFXEvent_On_Sighting" />
              <xsd:element type="xsd:integer" name="Political_Control" />
              <xsd:element type="Identifier" name="Political_Faction" />
              <xsd:element type="xsd:integer" name="Population_Value">
                <xsd:annotation>
                  <xsd:documentation> Sets how much of a population the unit takes up (fighters are
                    normally 1). Can be set it to 0 for an unlimited number of the unit in a battle. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="xsd:int" name="Projectile_Fire_Pulse_Count">
                <xsd:annotation>
                  <xsd:documentation> Example: 4 </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="xsd:float" name="Projectile_Fire_Pulse_Delay_Seconds">
                <xsd:annotation>
                  <xsd:documentation> Example: 0.1 </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="xsd:float" name="Projectile_Fire_Recharge_Seconds">
                <xsd:annotation>
                  <xsd:documentation> Example: 0.1 </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="Identifier" name="Projectile_Types">
                <xsd:annotation>
                  <xsd:documentation> Example: Proj_Ship_Small_Laser_Cannon_Red </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="Identifier" name="Property_Flags" />
              <xsd:element type="TgaImage" name="Radar_Icon_Name" />
              <xsd:element type="xsd:float" name="Radar_Icon_Scale_Land" />
              <xsd:element type="xsd:float" name="Radar_Icon_Scale_Space" />
              <xsd:element type="Identifier" name="Radar_Icon_Size" />
              <xsd:element type="xsd:float" name="Ranged_Target_Z_Adjust" />
              <xsd:element type="xsd:integer" name="Ranking_In_Category" />
              <xsd:element type="xsd:int" name="Reinforcement_Prevention_Radius" />
              <xsd:element type="xsd:boolean" name="Remove_Upon_Death">
                <xsd:annotation>
                  <xsd:documentation> Sets if this unit should be directly removed upon death
                    (true/false). </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="xsd:integer" name="Required_Ground_Base_Level">
                <xsd:annotation>
                  <xsd:documentation> Sets what ground base level is required to build the unit.
                    Note: You can set it to 0 to never have to build a ground base to build space
                    units. For space units this is normally 0. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="IdentifierList" name="Required_Planets" />
              <xsd:element type="Identifier" name="Required_Special_Structures" />
              <xsd:element type="xsd:integer" name="Required_Star_Base_Level">
                <xsd:annotation>
                  <xsd:documentation> Sets what space station level is required to build the unit.
                    Note: You can set it to 0 to never have to build a space station to build space
                    units. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="xsd:integer" name="Required_Timeline" />
              <xsd:element type="IdentifierIntTuple" name="Reserve_Spawned_Units_Tech_0"
                maxOccurs="unbounded">
                <xsd:annotation>
                  <xsd:documentation> Pair of a squadron unit and the number in reserve, separated
                    by a comma. Multiple items define multiple squadron types. Defines reserve
                    squadrons for tech 0 and later. Can be overwritten to define squadrons for a
                    later tech level. This entry might look like this: TIE_Fighter_Squadron, 8 </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="IdentifierIntTuple" name="Reserve_Spawned_Units_Tech_1"
                maxOccurs="unbounded">
                <xsd:annotation>
                  <xsd:documentation> Pair of a squadron unit and the number in reserve, separated
                    by a comma. Multiple items define multiple squadron types. Defines reserve
                    squadrons for tech 1 and later. Can be overwritten to define squadrons for a
                    later tech level. This entry might look like this: TIE_Fighter_Squadron, 8 </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="IdentifierIntTuple" name="Reserve_Spawned_Units_Tech_2"
                maxOccurs="unbounded">
                <xsd:annotation>
                  <xsd:documentation> Pair of a squadron unit and the number in reserve, separated
                    by a comma. Multiple items define multiple squadron types. Defines reserve
                    squadrons for tech 2 and later. Can be overwritten to define squadrons for a
                    later tech level. This entry might look like this: TIE_Fighter_Squadron, 8 </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="IdentifierIntTuple" name="Reserve_Spawned_Units_Tech_3"
                maxOccurs="unbounded">
                <xsd:annotation>
                  <xsd:documentation> Pair of a squadron unit and the number in reserve, separated
                    by a comma. Multiple items define multiple squadron types. Defines reserve
                    squadrons for tech 3 and later. Can be overwritten to define squadrons for a
                    later tech level. This entry might look like this: TIE_Fighter_Squadron, 8 </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="IdentifierIntTuple" name="Reserve_Spawned_Units_Tech_4"
                maxOccurs="unbounded">
                <xsd:annotation>
                  <xsd:documentation> Pair of a squadron unit and the number in reserve, separated
                    by a comma. Multiple items define multiple squadron types. Defines reserve
                    squadrons for tech 4 and later. Can be overwritten to define squadrons for a
                    later tech level. This entry might look like this: TIE_Fighter_Squadron, 8 </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="IdentifierIntTuple" name="Reserve_Spawned_Units_Tech_5"
                maxOccurs="unbounded">
                <xsd:annotation>
                  <xsd:documentation> Pair of a squadron unit and the number in reserve, separated
                    by a comma. Multiple items define multiple squadron types. Defines reserve
                    squadrons for tech 5. This entry might look like this: TIE_Fighter_Squadron, 8 </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="xsd:float" name="Scale_Factor">
                <xsd:annotation>
                  <xsd:documentation> Sets the scale factor of a unit from the model size to the
                    actual in-game size. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="xsd:integer" name="Score_Cost_Credits" />
              <xsd:element type="xsd:float" name="Select_Box_Scale" />
              <xsd:element type="Float" name="Select_Box_Z_Adjust">
                <xsd:annotation>
                  <xsd:documentation> Sets the z axis adjustment aka. the height level adjustment
                    for the model. This should be normally negative. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="Identifier" name="SFXEvent_Ambient_Loop" />
              <xsd:element type="Identifier" name="SFXEvent_Ambient_Moving" />
              <xsd:element type="xsd:int" name="SFXEvent_Ambient_Moving_Max_Delay_Seconds" />
              <xsd:element type="xsd:int" name="SFXEvent_Ambient_Moving_Min_Delay_Seconds" />
              <xsd:element type="Identifier" name="SFXEvent_Assist_Attack" />
              <xsd:element type="Identifier" name="SFXEvent_Assist_Move" />
              <xsd:element type="Identifier" name="SFXEvent_Attack">
                <xsd:annotation>
                  <xsd:documentation> Sets the sound effect that is played when this unit attacks
                    another unit. This is triggered by the attack command. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="IdentifierList" name="SFXEvent_Attack_Hardpoint"
                maxOccurs="unbounded" />
              <xsd:element type="Identifier" name="SFXEvent_Attack_With_Non_Hero_Ability" />
              <xsd:element type="Identifier" name="SFXEvent_Barrage" />
              <xsd:element type="Identifier" name="SFXEvent_Bombard_Incoming" />
              <xsd:element type="Identifier" name="SFXEvent_Bombard_Select_Target" />
              <xsd:element type="Identifier" name="SFXEvent_Build_Cancelled">
                <xsd:annotation>
                  <xsd:documentation> Sets the sound effect that is played when this unit build was
                    cancelled. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="Identifier" name="SFXEvent_Build_Complete">
                <xsd:annotation>
                  <xsd:documentation> Sets the sound effect that is played when this unit build is
                    complete. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="Identifier" name="SFXEvent_Build_Started">
                <xsd:annotation>
                  <xsd:documentation> Sets the sound effect that is played when this unit build
                    started. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="Identifier" name="SFXEvent_Damaged_By_Asteroid">
                <xsd:annotation>
                  <xsd:documentation> Sets the sound effect that is played when this unit is damaged
                    by an asteroid field. This is commonly SFX_Asteroid_Detonation. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="Identifier" name="SFXEvent_Enemy_Damaged_Health_Critical_Warning" />
              <xsd:element type="Identifier" name="SFXEvent_Enemy_Damaged_Health_Low_Warning" />
              <xsd:element type="Identifier" name="SFXEvent_Engine_Cinematic_Focus_Loop" />
              <xsd:element type="Identifier" name="SFXEvent_Engine_Idle_Loop">
                <xsd:annotation>
                  <xsd:documentation> Sets the sound effect that is played for the engine. The sound
                    effect is looped and always played in idle, aka. if no action is performend. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="Identifier" name="SFXEvent_Engine_Moving_Loop">
                <xsd:annotation>
                  <xsd:documentation> Sets the sound effect that is played for the engine when this
                    unit moves. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="Identifier" name="SFXEvent_Fire" />
              <xsd:element type="Identifier" name="SFXEvent_Fleet_Move" />
              <xsd:element type="Identifier" name="SFXEvent_Guard">
                <xsd:annotation>
                  <xsd:documentation> Sets the sound effect that is played when this unit guards
                    another unit. This is triggered by the guard command. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="Identifier" name="SFXEvent_Hardpoint" />
              <xsd:element type="IdentifierList" name="SFXEvent_Hardpoint_Destroyed"
                maxOccurs="unbounded">
                <xsd:annotation>
                  <xsd:documentation> Sets the sound effect that is played when a hardpoint of this
                    unit is destroyed. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="Identifier" name="SFXEvent_Health_Critical_Warning" />
              <xsd:element type="Identifier" name="SFXEvent_Health_Low_Warning" />
              <xsd:element type="Identifier" name="SFXEvent_Move">
                <xsd:annotation>
                  <xsd:documentation> Sets the sound effect that is played when this unit moves.
                    This is played only once when the move command was set for this unit. It is not
                    the sound for the engine. You can set this sound at SFXEvent_Engine_Idle_Loop
                    and SFXEvent_Engine_Moving_Loop. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="Identifier" name="SFXEvent_Move_Into_Asteroid_Field">
                <xsd:annotation>
                  <xsd:documentation> Sets the sound effect that is played when this unit moves into
                    an asteroid field. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="Identifier" name="SFXEvent_Move_Into_Nebula">
                <xsd:annotation>
                  <xsd:documentation> Sets the sound effect that is played when this unit moves into
                    a nebula field. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="Identifier" name="SFXEvent_Move_Opposite" />
              <xsd:element type="Identifier" name="SFXEvent_Select">
                <xsd:annotation>
                  <xsd:documentation> Sets the sound effect that is played when this unit is
                    selected. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="Identifier" name="SFXEvent_Stop">
                <xsd:annotation>
                  <xsd:documentation> Sets the sound effect that is played when this unit stops.
                    This is triggered by the stop command. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="Identifier" name="SFXEvent_Tactical_Build_Cancelled" />
              <xsd:element type="Identifier" name="SFXEvent_Tactical_Build_Complete" />
              <xsd:element type="Identifier" name="SFXEvent_Tactical_Build_Started" />
              <xsd:element type="Identifier" name="Shield_Armor_Type" />
              <xsd:element type="xsd:integer" name="Shield_Points">
                <xsd:annotation>
                  <xsd:documentation> Sets how many shield points the unit has. Set to -1 for
                    infinite. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="xsd:integer" name="Shield_Refresh_Rate">
                <xsd:annotation>
                  <xsd:documentation> Sets the interval in seconds to refresh a part of the shield.
                    For comparisation, capital ships like the calamari cruiser have a value of 50
                    and corvets a value between 10 and 20. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="Identifier" name="Ship_Class" />
              <xsd:element type="xsd:integer" name="Size_Value" />
              <xsd:element type="xsd:integer" name="Slice_Cost_Credits">
                <xsd:annotation>
                  <xsd:documentation> Sets what the slice cost is if the build is initially locked,
                    and can be unlocked by slicer (Yes/No). </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="xsd:float" name="Space_FOW_Reveal_Range">
                <xsd:annotation>
                  <xsd:documentation> Sets the reveal range of the fog of war. See
                    Dense_FOW_Reveal_Range_Multiplier for multiplayer. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="Identifier" name="Space_Full_Stop_Command" />
              <xsd:element type="Identifier" name="Space_Layer" />
              <xsd:element type="AloModel" name="Space_Model_Name">
                <xsd:annotation>
                  <xsd:documentation> Sets the .alo model name for this unit. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="IdentifierList" name="SpaceBehavior">
                <xsd:annotation>
                  <xsd:documentation> Sets the list of space behaviors for this unit. The values are
                    separated by a comma. Valid values in the base game are: - TACTICAL_SUPER_WEAPON
                    = This unit is a super weapon. - IDLE = This unit does nothing in battle. For
                    example, the death star has idle as a behavior. - FIGHTER_LOCOMOTOR - SELECTABLE
                    = This unit can be selected. - TARGETING - WEAPON = This unit has weapons. -
                    HIDE_WHEN_FOGGED = This unit is hidden when it is inside the fog of war. Large
                    unis like super weapons may not want to have this behavior. - AMBIENT_SFX -
                    DAMAGE_TRACKING - NEBULA = This units abilities are suppressed inside a nebula
                    aka. is effected by a nebula. - ABILITY_COUNTDOWN = This units abilities have a
                    countdown and/or a cooldown. - SIMPLE_SPACE_LOCOMOTOR - REVEAL - UNIT_AI -
                    ASTEROID_FIELD_DAMAGE = This unit can be damaged by asteroids. - SPAWN_SQUADRON
                    = This unit can spawn squadrons. - DAMAGE_TRACKING - ION_STUN_EFFECT Note that
                    space behaviours are a subset of common behaviours, see the Behaviour element.
                    In theory you can load common behaviours inside this element, but just because
                    you can does not mean you should. For example, you can load SHIELDED, which is a
                    common behaviour, inside this list of space behaviours. It is recommended to
                    split behaviours because it makes them more readable and is guaranteed to work
                    where mixing different types of behaviours can lead to bugs and loading
                    failures. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="xsd:integer" name="Spawned_Squadron_Delay_Seconds">
                <xsd:annotation>
                  <xsd:documentation> Defines the delay between spawning a new squadron in seconds. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="YesNo" name="Spin_Away_On_Death">
                <xsd:annotation>
                  <xsd:documentation> Sets if this unit can play a spin animation upon death. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="xsd:float" name="Spin_Away_On_Death_Chance">
                <xsd:annotation>
                  <xsd:documentation> Chance in percent, that this unit on death plays a spin
                    animation. Example: 0.2 </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="Identifier" name="Spin_Away_On_Death_Explosion">
                <xsd:annotation>
                  <xsd:documentation> Example: Small_Explosion_Space </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="Identifier" name="Spin_Away_On_Death_SFXEvent_Start_Die">
                <xsd:annotation>
                  <xsd:documentation> Example: Unit_A_Wing_Spinning_By </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="Float" name="Spin_Away_On_Death_Time">
                <xsd:annotation>
                  <xsd:documentation> Example: 2.0f </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="xsd:integer" name="Squadron_Capacity" />
              <xsd:element type="IdentifierIntTuple" name="Starting_Spawned_Units_Tech_0"
                maxOccurs="unbounded">
                <xsd:annotation>
                  <xsd:documentation> Pair of a squadron unit and the number spawned, separated by a
                    comma. Multiple items define multiple squadron types. Defines squadrons for tech
                    0 and later. Can be overwritten to define squadrons for a later tech level. This
                    entry might look like this: TIE_Fighter_Squadron, 2 </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="IdentifierIntTuple" name="Starting_Spawned_Units_Tech_1"
                maxOccurs="unbounded">
                <xsd:annotation>
                  <xsd:documentation> Pair of a squadron unit and the number spawned, separated by a
                    comma. Multiple items define multiple squadron types. Defines squadrons for tech
                    1 and later. Can be overwritten to define squadrons for a later tech level. This
                    entry might look like this: TIE_Fighter_Squadron, 2 </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="IdentifierIntTuple" name="Starting_Spawned_Units_Tech_2"
                maxOccurs="unbounded">
                <xsd:annotation>
                  <xsd:documentation> Pair of a squadron unit and the number spawned, separated by a
                    comma. Multiple items define multiple squadron types. Defines squadrons for tech
                    2 and later. Can be overwritten to define squadrons for a later tech level. This
                    entry might look like this: TIE_Fighter_Squadron, 2 </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="IdentifierIntTuple" name="Starting_Spawned_Units_Tech_3"
                maxOccurs="unbounded">
                <xsd:annotation>
                  <xsd:documentation> Pair of a squadron unit and the number spawned, separated by a
                    comma. Multiple items define multiple squadron types. Defines squadrons for tech
                    3 and later. Can be overwritten to define squadrons for a later tech level. This
                    entry might look like this: TIE_Fighter_Squadron, 2 </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="IdentifierIntTuple" name="Starting_Spawned_Units_Tech_4"
                maxOccurs="unbounded">
                <xsd:annotation>
                  <xsd:documentation> Pair of a squadron unit and the number spawned, separated by a
                    comma. Multiple items define multiple squadron types. Defines squadrons for tech
                    4 and later. Can be overwritten to define squadrons for a later tech level. This
                    entry might look like this: TIE_Fighter_Squadron, 2 </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="IdentifierIntTuple" name="Starting_Spawned_Units_Tech_5"
                maxOccurs="unbounded">
                <xsd:annotation>
                  <xsd:documentation> Pair of a squadron unit and the number spawned, separated by a
                    comma. Multiple items define multiple squadron types. Defines squadrons for tech
                    5. This entry might look like this: TIE_Fighter_Squadron, 2 </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="xsd:float" name="Strafe_Distance" />
              <xsd:element type="YesNo" name="Surface_Bombardment_Capable">
                <xsd:annotation>
                  <xsd:documentation> Sets whether or not a unit allows surface bombarding in groud
                    battles (Yes/No). Defaults to no. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="xsd:integer" name="Tactical_Build_Cost_Multiplayer">
                <xsd:annotation>
                  <xsd:documentation> Build cost in credits for tactical multiplayer. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="Identifier" name="Tactical_Build_Prerequisites">
                <xsd:annotation>
                  <xsd:documentation> Build prerequsites for tactical multiplayer. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="xsd:integer" name="Tactical_Build_Time_Seconds">
                <xsd:annotation>
                  <xsd:documentation> Build time in seconds for tactical multiplayer. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="xsd:integer" name="Tactical_Health">
                <xsd:annotation>
                  <xsd:documentation> Sets how many shield points the unit has. Set to -1 for
                    infinite. Note: Autoresolve health is defined at Autoresolve_Health. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="Identifier" name="Tactical_Production_Queue">
                <xsd:annotation>
                  <xsd:documentation> Production queue for tactical multiplayer. For space units
                    this is normally Tactical_Units. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="IdentifierList" name="Target_Bones" />
              <xsd:element type="xsd:float" name="Targeting_Fire_Inaccuracy_Fixed_Radius" />
              <xsd:element type="xsd:float" name="Targeting_Max_Attack_Distance" />
              <xsd:element type="xsd:float" name="Targeting_Min_Attack_Distance" />
              <xsd:element type="Identifier" name="Targeting_Priority_Set">
                <xsd:annotation>
                  <xsd:documentation> Sets which type of enemies should be prioritized by this unit.
                    For example, you can set this value to "Frigate" for always prioritizing
                    frigates. Valid values in the base game are: Corvette, Frigate, Capital,
                    Fighter, Bomber </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="xsd:float" name="Targeting_Stickiness_Time_Threshold" />
              <xsd:element type="xsd:integer" name="Tech_Level">
                <xsd:annotation>
                  <xsd:documentation> Sets the tech level unit becomes available, for Rebels 0-3,
                    for the Empire 1-4. </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="Identifier" name="Text_ID" />
              <xsd:element type="xsd:integer" name="Transport_Capacity" />
              <xsd:element type="xsd:float" name="Turret_Elevate_Extent_Degrees" />
              <xsd:element type="xsd:float" name="Turret_Rotate_Extent_Degrees" />
              <xsd:element name="Unit_Abilities_Data">
                <xsd:annotation>
                  <xsd:documentation> List of activated abilities. Activated abilities are abilities
                    that can be activated and deactivated with the ui buttons. </xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element type="Ability" name="Unit_Ability" maxOccurs="unbounded">
                      <xsd:annotation>
                        <xsd:documentation>Primary ability</xsd:documentation>
                      </xsd:annotation>
                    </xsd:element>
                  </xsd:sequence>
                  <xsd:attribute type="Identifier" name="SubObjectList" />
                </xsd:complexType>
              </xsd:element>
              <xsd:element type="Identifier" name="Variant_Of_Existing_Type" />
              <xsd:element type="YesNo" name="Victory_Relevant" />
              <xsd:element type="xsd:boolean" name="Visible_On_Radar_When_Fogged">
                <xsd:annotation>
                  <xsd:documentation> Sets if this unit is visible when inside the fog of war. For
                    example, most capital ships are still visible. Default is no (Yes/No). </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element type="AloModel" name="xxxSpace_Model_Name" />
            </xsd:choice>
          </xsd:sequence>
          <xsd:attribute type="Identifier" name="Name" />
        </xsd:complexType>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:element name="SpaceUnits" type="SpaceUnits" />
  <xsd:element name="SpaceUnitsFrigates" type="SpaceUnits" />
  <xsd:element name="SpaceUnitsCapital" type="SpaceUnits" />
  <xsd:element name="SpaceCorvettes" type="SpaceUnits" />
  <xsd:element name="FighterUnits" type="SpaceUnits" />
</xsd:schema>